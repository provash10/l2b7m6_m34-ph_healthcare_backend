model Payment {
    id String @id @default(uuid())

    status PaymentStatus @default(UNPAID)

    amount Decimal @db.Decimal(10,2) //123123.63 tk
    currency String @default("BDT")

    paymentGetway String @default("bkash") //40-2
    merchanInvoiceNumber String @unique //appointment id
    
    bkashPaymentId String? @unique
    bkashTrxId String?
    payerReference String? //user email / phone number
    paidAt String?

    gatewayResponse Json?

    refundTrxId String?
    refundAmount Decimal @db.Decimal(10,2)
    refundReason String?
    refundedAt String?  //40-2

    appointmentId String @unique
    appointment Appointment @relation(fields:[appointmentId],references:[id], onDelete: Cascade, onUpdate: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("payments")
}