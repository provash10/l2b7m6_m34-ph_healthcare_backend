<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Doctor Application Approved</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f7f7f7; color: #333; }
        .container { max-width: 500px; margin: 40px auto; background: #fff; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
        .footer { margin-top: 30px; font-size: 12px; color: #888; }
        .password-box { background: #eef2f7; padding: 10px 15px; border-radius: 4px; font-family: monospace; font-size: 15px; margin: 15px 0; }
    </style>
</head>
<body>
    <div class="container">
        <h2>Congratulations, Dr. <%= name %>!</h2>
        <p>Your application to join PH Healthcare System as a doctor has been reviewed and approved.</p>
        <p>You can now log in and start managing your schedule and consultations.</p>
        <% if (locals.password) { %>
            <div class="password-box">
                <strong>Temporary Password:</strong> <%= password %>
            </div>
            <p><small>Please change your password upon your first login.</small></p>
        <% } %>
        <div class="footer">&copy; PH Healthcare System. All rights reserved.</div>
    </div>
</body>
</html>
